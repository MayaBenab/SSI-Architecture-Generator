digraph A { rankdir=TB; compound=true; nodesep=0.3; ranksep=0.5; pad=0.1; fontname=Helvetica;
node [fontname=Helvetica, fontsize=20, shape=box, style="rounded,filled", margin="0.12,0.05", fillcolor="#f7ebdd", color="#5b2a12", penwidth=1.6];
edge [fontname=Helvetica, fontsize=16, color="#374151", fontcolor="#5b2a12", penwidth=1.6, arrowsize=1.1];
subgraph "cluster_Holder" { label="Holder"; style="rounded,filled"; fontname=Helvetica; fillcolor="#fbf6f0"; color="#5b2a12"; penwidth=2; fontsize=22;
"Holder" [label="", shape=point, style=invis];
"Wallet" [label="Wallet"];
}
subgraph "cluster_Issuer" { label="Issuer"; style="rounded,filled"; fontname=Helvetica; fillcolor="#fbf6f0"; color="#5b2a12"; penwidth=2; fontsize=22;
"Issuer" [label="", shape=point, style=invis];
"Wallet_I" [label="Wallet"];
}
subgraph "cluster_Verifier" { label="Verifier"; style="rounded,filled"; fontname=Helvetica; fillcolor="#fbf6f0"; color="#5b2a12"; penwidth=2; fontsize=22;
"Verifier" [label="", shape=point, style=invis];
"Wallet_V" [label="Wallet"];
}
"VDR" [label="VDR\nVerifiable data registry (abstract)"];
"Issuer" -> "Holder" [style=dotted, label="issue credentials (VC)", lhead="cluster_Holder", ltail="cluster_Issuer"];
"Holder" -> "Verifier" [style=dotted, label="present presentations (VP)", lhead="cluster_Verifier", ltail="cluster_Holder"];
"Issuer" -> "VDR" [style=dotted, label="register identifiers and schemas (DID, schema)", ltail="cluster_Issuer"];
"Holder" -> "VDR" [style=dotted, label="verify identifiers and schemas (DID, schema)", ltail="cluster_Holder"];
"Verifier" -> "VDR" [style=dotted, label="verify identifiers and schemas (DID, schema)", ltail="cluster_Verifier"];
}