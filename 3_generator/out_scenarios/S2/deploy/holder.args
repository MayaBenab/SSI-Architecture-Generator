--admin 0.0.0.0 8021
--admin-insecure-mode
--inbound-transport http 0.0.0.0 8020
--outbound-transport http
--endpoint http://holder:8020
--label holder
--wallet-name holder
--wallet-key holder-key
--auto-provision
--auto-accept-invites
--auto-accept-requests
--auto-respond-credential-offer
--auto-store-credential
--log-level info
--wallet-local-did
--wallet-type askar
--wallet-storage-type postgres_storage
--wallet-storage-config '{"url":"postgres:5432","wallet_scheme":"DatabasePerWallet"}'
--wallet-storage-creds '{"account":"postgres","password":"wallet","admin_account":"postgres","admin_password":"wallet"}'
--no-ledger
